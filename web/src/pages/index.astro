---
import '../styles/tokens.css';
import '../styles/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Dr. (Maj) Nikhil Prakash — general physician. Unhurried consultations, preventive care, and chronic-disease management. Book an appointment."
		/>
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
		<noscript>
			<style>
				.reveal,
				.reveal-on-scroll {
					opacity: 1 !important;
					transform: none !important;
					animation: none !important;
				}
				.nav__sheet[hidden] {
					display: grid;
				}
			</style>
		</noscript>
		<title>Dr. (Maj) Nikhil Prakash — General Physician</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<!-- Nav · N1b — brand left · About/Services/Contact centre · Log in/Sign up + Book appointment right -->
		<header class="nav">
			<div class="nav__inner">
				<a class="nav__brand" href="#top" aria-label="Dr. (Maj) Nikhil Prakash — home">
					<span class="brand-mark" aria-hidden="true">+</span>
					<span>Dr. (Maj) Nikhil Prakash</span>
				</a>
				<nav class="nav__center" aria-label="Primary">
					<a class="nav__link" href="#about">About</a>
					<a class="nav__link" href="#services">Services</a>
					<a class="nav__link" href="#contact">Contact</a>
				</nav>
				<div class="nav__right">
					<!-- TODO: point these at the real auth routes -->
					<a class="nav__link nav__link--text" href="/login">Login</a>
					<a class="btn btn--pear btn--sm" href="#book">Book appointment</a>
					<button
						class="nav__toggle"
						type="button"
						aria-expanded="false"
						aria-controls="mobile-menu"
					>
						Menu
					</button>
				</div>
			</div>
			<div class="nav__sheet" id="mobile-menu" hidden>
				<a class="nav__link" href="#about">About</a>
				<a class="nav__link" href="#services">Services</a>
				<a class="nav__link" href="#contact">Contact</a>
				<a class="nav__link" href="/login">Login</a>
				<a class="btn btn--pear btn--sm" href="#book">Book appointment</a>
			</div>
		</header>

		<main id="main">
			<!-- Hero — giant typography: headline centre, credentials right, CTA + stats bottom -->
			<section class="hero" id="top" aria-labelledby="hero-heading">
				<!-- Frame sizes itself to the headline, so row + foot align to its edges -->
				<div class="hero__frame">
					<p class="hero__eyebrow reveal" style="--i: 0">
						Medicine that starts with listening
					</p>
					<h1 class="hero__headline reveal" style="--i: 1" id="hero-heading">
						Dr. (Maj) Nikhil Prakash
					</h1>
					<div class="hero__row reveal" style="--i: 2">
						<div class="hero__role-block">
							<p class="hero__cred-role">Consultant Physician</p>
							<p class="hero__specialty">
								Stomach, Kidney and Arthritis specialist
							</p>
						</div>
						<div class="hero__cred">
							<p>MBBS (AFMC, Pune)</p>
							<p>M.D (Research &amp; Referral, Delhi)</p>
						</div>
					</div>
					<p class="hero__tagline reveal" style="--i: 3">
						Unhurried consultations, plain-language explanations, and care that
						starts with your story — not a prescription.
					</p>
					<div class="hero__foot">
						<a class="btn btn--pear btn--lg reveal" style="--i: 2" href="#book"
							>Book an appointment <span class="btn__arrow" aria-hidden="true">↗</span></a
						>
						<!-- TODO: replace these figures with real numbers before launch -->
						<dl class="hero__stats reveal" style="--i: 3">
							<div class="stat">
								<dt>Satisfied patients</dt>
								<dd>10k+</dd>
							</div>
							<div class="stat">
								<dt>Years of experience</dt>
								<dd>10+</dd>
							</div>
						</dl>
					</div>
				</div>
			</section>

			<!-- About — Split Studio, flipped -->
			<section class="split split--flip" id="about" aria-labelledby="about-heading">
				<div class="split__text reveal-on-scroll">
					<h2 id="about-heading">The doctor, not the queue.</h2>
					<p>
						Most visits to a doctor end before they begin — three minutes, a
						scribbled slip, and a doorway. This practice is built the other way
						around: enough time to hear the whole story, and the patience to
						treat the person, not just the report.
					</p>
					<p>
						Dr. (Maj) Nikhil Prakash practises general medicine — the everyday,
						first-line kind. Fevers that won't settle, blood pressures that
						creep, sugars that drift. The work is careful diagnosis, honest
						explanation, and the smallest effective treatment.
					</p>
				</div>
				<div class="split__panel panel panel--cyan reveal-on-scroll">
					<h3>How a visit goes</h3>
					<ul class="principles">
						<li>Time to tell the whole story</li>
						<li>Explanations in plain language</li>
						<li>Tests only when they change the plan</li>
						<li>One doctor who remembers your history</li>
					</ul>
				</div>
			</section>

			<!-- Services — colour-shift card grid, asymmetric spans -->
			<section class="services" id="services" aria-labelledby="services-heading">
				<div class="section-head reveal-on-scroll">
					<h2 id="services-heading">What the clinic treats</h2>
					<p>
						Everyday medicine, done carefully. If something needs a specialist,
						you'll be told so — and pointed to the right one.
					</p>
				</div>
				<ul class="cards">
					<li class="card card--pear reveal-on-scroll">
						<h3>General consultation</h3>
						<p>
							Fever, infections, and everyday illness — diagnosed carefully,
							treated conservatively.
						</p>
					</li>
					<li class="card card--cyan reveal-on-scroll">
						<h3>Preventive health checks</h3>
						<p>
							Annual screenings and reviews that catch things early, not late.
						</p>
					</li>
					<li class="card card--mint reveal-on-scroll">
						<h3>Chronic care</h3>
						<p>
							Diabetes, hypertension, thyroid — monitored steadily and adjusted
							as you change.
						</p>
					</li>
					<li class="card card--lavender reveal-on-scroll">
						<h3>Vaccinations</h3>
						<p>
							Adult immunisations, travel vaccines, and boosters — on schedule,
							without the runaround.
						</p>
					</li>
					<li class="card card--neutral reveal-on-scroll">
						<h3>Minor procedures</h3>
						<p>
							Dressings, suturing, and small in-clinic procedures — done cleanly,
							explained fully.
						</p>
					</li>
				</ul>
			</section>

			<!-- Book — the coral emphatic moment -->
			<section class="book" id="book" aria-labelledby="book-heading">
				<div class="book__inner reveal-on-scroll">
					<h2 id="book-heading">Booking takes two minutes.</h2>
					<ol class="steps">
						<li>
							<h3>Pick a slot</h3>
							<p>
								Choose a time that suits you — morning or evening, six days a
								week.
							</p>
						</li>
						<li>
							<h3>Share your concern</h3>
							<p>
								A line about why you're coming helps the doctor prepare before
								you arrive.
							</p>
						</li>
						<li>
							<h3>Meet Dr. Prakash</h3>
							<p>Walk in, sit down, and take the time you need.</p>
						</li>
					</ol>
					<div class="book__cta">
						<!-- TODO: wire to the booking flow -->
						<a class="btn btn--coral btn--lg" href="/book"
							>Book an appointment <span class="btn__arrow" aria-hidden="true">→</span></a
						>
						<p class="book__note">or call the clinic directly</p>
					</div>
				</div>
			</section>

			<!-- Contact -->
			<section class="contact" id="contact" aria-labelledby="contact-heading">
				<div class="contact__grid">
					<div class="reveal-on-scroll">
						<h2 id="contact-heading">Find the clinic</h2>
						<!-- TODO: replace with the clinic's real name, address, phone, and email -->
						<address>
							<span>Prakash Clinic</span>
							<span>Shop 4, Sunrise Plaza, MG Road</span>
							<span>Your City — 400 001</span>
						</address>
						<div class="contact__links">
							<a href="tel:+919800000000">+91 98000 00000</a>
							<a href="mailto:clinic@drnikhilprakash.in">clinic@drnikhilprakash.in</a>
						</div>
					</div>
					<div class="contact__hours reveal-on-scroll">
						<h3>Consultation hours</h3>
						<dl class="hours">
							<div>
								<dt>Mon–Sat</dt>
								<dd>9:00&nbsp;am – 1:00&nbsp;pm · 5:00&nbsp;pm – 8:00&nbsp;pm</dd>
							</div>
							<div>
								<dt>Sunday</dt>
								<dd>Closed</dd>
							</div>
						</dl>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer · Ft5 statement -->
		<footer class="foot-stmt">
			<p class="foot-stmt__line">Good medicine is mostly listening.</p>
			<div class="foot-stmt__meta">
				<span class="wordmark">Dr. (Maj) Nikhil Prakash</span>
				<nav aria-label="Footer">
					<a href="#about">About</a>
					<a href="#services">Services</a>
					<a href="#contact">Contact</a>
				</nav>
				<span class="muted">© 2026 Dr. (Maj) Nikhil Prakash</span>
			</div>
		</footer>

		<script>
			// Frost-on-scroll nav (rAF-throttled)
			const nav = document.querySelector('.nav');
			let ticking = false;
			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					nav?.classList.toggle('is-scrolled', window.scrollY > 24);
					ticking = false;
				});
			};
			window.addEventListener('scroll', onScroll, { passive: true });

			// Mobile menu disclosure
			const toggle = document.querySelector('.nav__toggle');
			const sheet = document.getElementById('mobile-menu');
			toggle?.addEventListener('click', () => {
				if (!toggle || !sheet) return;
				const open = toggle.getAttribute('aria-expanded') === 'true';
				toggle.setAttribute('aria-expanded', String(!open));
				sheet.hidden = open;
			});
			sheet?.addEventListener('click', (e) => {
				if (e.target instanceof Element && e.target.closest('a') && sheet && toggle) {
					sheet.hidden = true;
					toggle.setAttribute('aria-expanded', 'false');
				}
			});

			// One-shot scroll reveal
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-in');
							io.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.15 },
			);
			document.querySelectorAll('.reveal-on-scroll').forEach((el) => io.observe(el));
		</script>
	</body>
</html>
