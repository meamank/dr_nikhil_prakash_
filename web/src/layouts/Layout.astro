---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Dr. (Maj) Nikhil Prakash — consultant physician. Unhurried consultations, preventive care, and chronic-disease management. Book an appointment.",
} = Astro.props;

// Canonical URL (falls back gracefully if `site` is not configured)
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A3E36" />

    {/* Primary SEO */}
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    {/* Open Graph (Facebook, LinkedIn, Slack…) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dr. (Maj) Nikhil Prakash" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {/* TODO: add a 1200×630 social cover image at public/images/og-cover.png,
        then add: <meta property="og:image" content={new URL("/images/og-cover.png", Astro.site)} /> */}

    {/* Twitter/X */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Structured data: MedicalOrganization */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalOrganization",
      name: "Dr. (Maj) Nikhil Prakash",
      alternateName: "Dr. Nikhil Prakash, MD",
      description,
      url: canonicalURL?.toString(),
      telephone: "+91-98013-17878",
      areaServed: { "@type": "AdministrativeArea", name: "Muzaffarpur, Bihar" },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Muzaffarpur",
        addressRegion: "Bihar",
        addressCountry: "IN",
      },
    })} />
  </head>
  <body class="min-h-dvh bg-background font-sans text-ink antialiased">
    <slot />
  </body>
</html>
